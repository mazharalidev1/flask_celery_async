    {
      "id": 22,
      "type": "stat",
      "title": "Task Failure %",
      "description": "Failed tasks as a percentage of terminal task outcomes.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(flask_async_celery_task_failed_total{task_name=~\"$task_name\",worker=~\"$worker\"}) / clamp_min(sum(flask_async_celery_task_completed_total{task_name=~\"$task_name\",worker=~\"$worker\"}) + sum(flask_async_celery_task_failed_total{task_name=~\"$task_name\",worker=~\"$worker\"}) + sum(flask_async_celery_task_cancelled_total{task_name=~\"$task_name\",worker=~\"$worker\"}), 1)",
          "legendFormat": "Failure %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
